---
import '@fontsource-variable/source-code-pro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const socials = [
  {
    name: 'x',
    oldName: 'twitter',
    url: 'https://x.com/phlp_',
  },
  {
    name: 'github',
    url: 'https://github.com/ph1p',
  },
  {
    name: 'figma',
    url: 'https://figma.com/@p',
  },
  {
    name: 'codepen',
    url: 'https://codepen.io/ph1p',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-black p-10 text-white md:p-20 sm:h-screen">
    <main class="grid grid-rows-header h-full gap-y-28">
      <header class="flex justify-between items-start gap-x-8">
        <div class="logo">
          <svg
            width="140"
            height="99"
            viewBox="0 0 140 99"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect
              y="31.1106"
              width="15.5554"
              height="67.4066"
              rx="7.7777"
              fill="white"></rect>
            <rect
              x="103.703"
              y="31.1106"
              width="15.5554"
              height="67.4066"
              rx="7.7777"
              fill="white"></rect>
            <rect
              x="41.4844"
              y="-0.000244141"
              width="15.5554"
              height="67.4066"
              rx="7.7777"
              fill="white"></rect>
            <rect
              x="20.7422"
              y="31.1106"
              width="15.5554"
              height="36.2958"
              rx="7.7777"
              fill="white"></rect>
            <rect
              x="124.445"
              y="31.1106"
              width="15.5554"
              height="36.2958"
              rx="7.7777"
              fill="white"></rect>
            <rect
              x="62.2188"
              y="31.1106"
              width="15.5554"
              height="36.2958"
              rx="7.7777"
              fill="white"></rect>
            <rect
              x="62.2188"
              y="7.77734"
              width="15.5554"
              height="15.5554"
              rx="7.77768"
              fill="white"></rect>
            <rect
              x="82.9609"
              y="-0.000244141"
              width="15.5554"
              height="67.4066"
              rx="7.7777"
              fill="white"></rect>
          </svg>
        </div>
        <div class="social">
          <nav aria-label="Socialmedia-Accounts">
            <ul role="menu">
              {
                socials.map((social) => (
                  <li>
                    <a
                      role="menuitem"
                      class="link"
                      target="_blank"
                      href={social.url}
                    >
                      {social.oldName && (
                        <span class="line-through decoration-neutral-700 mr-2 text-neutral-700">
                          {social.oldName}
                        </span>
                      )}
                      {social.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </header>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    font-family: 'Source Code Pro Variable', monospace;
  }
  ::selection {
    background: #fff;
    color: #000;
  }
  * {
    box-sizing: border-box;
  }
  a.link {
    @apply relative inline-block px-0 py-0.5 before:content-[''] before:absolute before:h-0.5 before:bg-white before:transition-all before:duration-[0.1s] before:ease-[ease-in-out] before:z-[-1] before:bottom-0 before:-inset-x-0.5 hover:text-black hover:before:h-full;
  }
</style>
